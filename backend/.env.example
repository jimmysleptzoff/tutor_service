# Copy this file to `backend/.env` and fill in values. Do NOT commit `.env` to GitHub.

# MySQL (port is the database server — almost always 3306, NOT the Express API port)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=tutorScheduler

# Express API (default 5001 avoids macOS AirPlay on 5000; must match frontend/package.json "proxy" in dev)
PORT=5001
